prim_key ROMAN_TO_INT
prim_scope per_unit
prim_param concept str
prim_ret _r
# 罗马数字→整数（原件 = TheAlgorithms/Python conversions/roman_numerals.py roman_to_int）
# 语义：v[i] < v[i+1] ⇒ total += v1-v0·i+=2；否则 total += v0·i+=1（减法前缀规则）
# 中间变量一律局部槽 _ 前缀（$形参形式仅用于真形参 concept）·结果写 result 记忆（仓约定）
str_cat a='$concept' out_concept='rm_in'
str_len concept='rm_in' out='_n'
eval_expr src='0' out='_i'
eval_expr src='0' out='_total'
if cond='_n > 0'
body_open
while until='_i >= _n'
body_open
str_num n='0' out_concept='rm_c0'
str_num n='0' out_concept='rm_c1'
str_slice from_concept='rm_in' start='_i' len='1' out_concept='rm_c0' out='_s0'
eval_expr src='_i + 1' out='_i1'
str_slice from_concept='rm_in' start='_i1' len='1' out_concept='rm_c1' out='_s1'
str_ord from_concept='rm_c0' out='_o0'
call prim='CHAR_VAL' o='_o0' out='_v0'
str_ord from_concept='rm_c1' out='_o1'
call prim='CHAR_VAL' o='_o1' out='_v1'
if cond='_v0 < _v1'
body_open
eval_expr src='_total + _v1 - _v0' out='_total'
eval_expr src='_i + 2' out='_i'
body_close
if cond='_v0 >= _v1'
body_open
eval_expr src='_total + _v0' out='_total'
eval_expr src='_i + 1' out='_i'
body_close
body_close
body_close
str_num n='0' out_concept='result'
write_mem type='knowledge' concept='result' val='$_total' out='_r'

